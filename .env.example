# ---- AI (optional) — enables richer LLM event extraction ----
# Without it, a deterministic rule-based extractor runs (zero-config).
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-sonnet-4-5

# ---- Database (optional, Phase 2) — Prisma/Postgres ----
# Without it, events live in an in-memory store (per-process, resets on restart).
DATABASE_URL=postgresql://user:pass@localhost:5432/daily_edition

# ---- Public ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=The Daily Edition
